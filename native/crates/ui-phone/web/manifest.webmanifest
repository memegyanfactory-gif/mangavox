{
  "id": "/",
  "name": "MangaVox",
  "short_name": "MangaVox",
  "description": "Read manga, watch movies and anime, listen and control MangaVox on your PC from your phone.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090f",
  "theme_color": "#09090f",
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Activity", "short_name": "Activity", "description": "What your PC is doing now", "url": "/#/activity", "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Library", "short_name": "Library", "url": "/#/library", "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Studio", "short_name": "Studio", "url": "/#/studio", "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
