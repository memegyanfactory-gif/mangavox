      "Bash(node_modules/electron/dist/Electron.app/Contents/MacOS/Electron -e \"const e = require\\(''electron''\\); console.log\\(''app type:'', typeof e.app\\); console.log\\(''keys:'', Object.keys\\(e\\).join\\('', ''\\)\\)\")",
      "Bash(node_modules/electron/dist/Electron.app/Contents/MacOS/Electron -e \"console.log\\(process.versions.electron\\)\")",
      "Bash(node -e \":*)",
      "Bash(node_modules/electron/dist/Electron.app/Contents/MacOS/Electron --no-sandbox -e \":*)",
      "Bash(\"/Users/aayush/Documents/VS CODE/MANGA VOX/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron\" -e \"console.log\\(''electron:'', process.versions.electron, ''node:'', process.versions.node\\)\")",
      "Bash(sqlite3 ~/.mangavox/mangavox.db \".tables\")",
      "Bash(sqlite3 ~/.mangavox/mangavox.db \".schema manga\")",
      "Bash(pkill -f \"electron.*MANGA.VOX\")",
      "Bash(pkill -f \"electron-vite\")",
