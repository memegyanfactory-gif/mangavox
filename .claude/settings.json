      "Bash(echo \"const e = require\\(\"\"electron\"\"\\); console.log\\(\"\"type:\"\", typeof e, \"\"isString:\"\", typeof e === \"\"string\"\"\\); console.log\\(\"\"keys:\"\", typeof e === \"\"object\"\" ? Object.keys\\(e\\).join\\(\"\",\"\"\\) : e.substring\\(0, 100\\)\\); process.exit\\(0\\)\")",
      "Bash(node_modules/electron/dist/Electron.app/Contents/MacOS/Electron /tmp/tst.js)"
